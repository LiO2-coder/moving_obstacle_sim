<launch>
  <arg name="world_name" default="worlds/empty.world" />
  <arg name="paused" default="false" />
  <arg name="gui" default="true" />
  <arg name="headless" default="false" />
  <arg name="debug" default="false" />

  <arg name="obstacles_config" default="pkg://moving_obstacle_sim/config/moving_obstacles_demo.yaml" />

  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="world_name" value="$(arg world_name)" />
    <arg name="paused" value="$(arg paused)" />
    <arg name="gui" value="$(arg gui)" />
    <arg name="headless" value="$(arg headless)" />
    <arg name="debug" value="$(arg debug)" />
  </include>

  <include file="$(find moving_obstacle_sim)/launch/include/spawn_from_config.launch.xml">
    <arg name="obstacles_config" value="$(arg obstacles_config)" />
    <arg name="reference_frame" value="world" />
    <arg name="delete_if_exists" value="false" />
  </include>
</launch>
