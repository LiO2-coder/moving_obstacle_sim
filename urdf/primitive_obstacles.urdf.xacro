<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="primitive_obstacles">
  <xacro:macro name="obstacle_box" params="name mass x y z rr rp ry sx sy sz rgba:='0.7 0.7 0.7 1.0'">
    <link name="${name}">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="${mass}"/>
        <inertia ixx="${mass*(sy*sy+sz*sz)/12.0}" ixy="0" ixz="0"
                 iyy="${mass*(sx*sx+sz*sz)/12.0}" iyz="0"
                 izz="${mass*(sx*sx+sy*sy)/12.0}"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="${sx} ${sy} ${sz}"/>
        </geometry>
        <material name="${name}_mat">
          <color rgba="${rgba}"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="${sx} ${sy} ${sz}"/>
        </geometry>
      </collision>
    </link>
    <joint name="${name}_joint" type="fixed">
      <parent link="world"/>
      <child link="${name}"/>
      <origin xyz="${x} ${y} ${z}" rpy="${rr} ${rp} ${ry}"/>
    </joint>
  </xacro:macro>

  <xacro:macro name="obstacle_sphere" params="name mass x y z rr rp ry radius rgba:='0.2 0.4 0.9 1.0'">
    <link name="${name}">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="${mass}"/>
        <inertia ixx="${2.0*mass*radius*radius/5.0}" ixy="0" ixz="0"
                 iyy="${2.0*mass*radius*radius/5.0}" iyz="0"
                 izz="${2.0*mass*radius*radius/5.0}"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <sphere radius="${radius}"/>
        </geometry>
        <material name="${name}_mat">
          <color rgba="${rgba}"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <sphere radius="${radius}"/>
        </geometry>
      </collision>
    </link>
    <joint name="${name}_joint" type="fixed">
      <parent link="world"/>
      <child link="${name}"/>
      <origin xyz="${x} ${y} ${z}" rpy="${rr} ${rp} ${ry}"/>
    </joint>
  </xacro:macro>

  <xacro:macro name="obstacle_cylinder" params="name mass x y z rr rp ry radius length rgba:='0.2 0.8 0.3 1.0'">
    <link name="${name}">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="${mass}"/>
        <inertia ixx="${mass*(3.0*radius*radius+length*length)/12.0}" ixy="0" ixz="0"
                 iyy="${mass*(3.0*radius*radius+length*length)/12.0}" iyz="0"
                 izz="${0.5*mass*radius*radius}"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="${radius}" length="${length}"/>
        </geometry>
        <material name="${name}_mat">
          <color rgba="${rgba}"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="${radius}" length="${length}"/>
        </geometry>
      </collision>
    </link>
    <joint name="${name}_joint" type="fixed">
      <parent link="world"/>
      <child link="${name}"/>
      <origin xyz="${x} ${y} ${z}" rpy="${rr} ${rp} ${ry}"/>
    </joint>
  </xacro:macro>

  <xacro:obstacle_box name="sample_box" mass="2.0" x="0.0" y="0.0" z="0.5" rr="0" rp="0" ry="0" sx="0.6" sy="0.4" sz="1.0"/>
</robot>
